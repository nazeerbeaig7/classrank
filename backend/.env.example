# ClassRank Environment Configuration

# Server Port
PORT=5000

# MongoDB Connection String
# For Local Database: mongodb://127.0.0.1:27017/classrank
# For MongoDB Atlas Cloud (Vercel Deployment): mongodb+srv://<username>:<password>@cluster.mongodb.net/classrank?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/classrank

# JWT Authentication
JWT_SECRET=classrank_super_secret_jwt_key_2026_academic_perf
JWT_EXPIRE=30d

# Fallback Settings
ALLOW_MEMORY_SERVER=true
